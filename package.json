{
  "name": "@ts-76/inertia-hono-jsx",
  "version": "0.2.2",
  "license": "MIT",
  "description": "A Hono JSX adapter for Inertia.js",
  "homepage": "https://github.com/ts-76/inertia-hono-jsx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ts-76/inertia-hono-jsx.git"
  },
  "bugs": {
    "url": "https://github.com/ts-76/inertia-hono-jsx/issues"
  },
  "keywords": [
    "inertia",
    "inertiajs",
    "hono",
    "hono-jsx",
    "hono-jsx-dom"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "types/server.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "pnpm clean && node build.js && tsc",
    "build:with-deps": "node build.js --with-deps",
    "clean": "node -e \"fs.rmSync('types', { recursive: true, force: true }); fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "pnpx concurrently -c \"#ffcf00,#3178c6\" \"pnpm dev:build\" \"pnpm dev:types\" --names build,types",
    "dev:build": "node build.js --watch",
    "dev:types": "tsc --watch --preserveWatchOutput",
    "es2022-check": "pnpm build:with-deps && es-check es2022 \"dist/index.js\" --checkFeatures --module --noCache --verbose",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@hono/inertia": "^0.2.0",
    "es-check": "^9.6.1",
    "esbuild": "^0.27.3",
    "esbuild-node-externals": "^1.20.1",
    "hono": "^4.12.20",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@hono/inertia": "^0.2.0",
    "hono": "^4.12.20"
  },
  "dependencies": {
    "@inertiajs/core": "^3.0.3",
    "es-toolkit": "^1.45.1",
    "laravel-precognition": "^2.0.0"
  }
}
